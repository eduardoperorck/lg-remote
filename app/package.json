{
  "name": "lgremote-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Controle da TV LG que fala direto com a TV, sem PC no meio.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "faketv": "node --experimental-strip-types test/fake-tv-cli.ts",
    "dev": "vite",
    "build": "vite build",
    "sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "lg-ssap": "file:./plugins/lg-ssap",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
