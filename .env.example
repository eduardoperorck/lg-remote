# --- TV -----------------------------------------------------------------
# IP da TV: Configurações > Rede > Conexão Wi-Fi/Cabo > Avançado.
# Se ele mudar, o controle reencontra a TV sozinho pelo TV_UUID e regrava esta linha.
TV_HOST=192.168.0.10

# MAC da TV (mesma tela do IP). Usado para Wake-on-LAN (ligar a TV) e como segunda
# pista para reencontrá-la quando o IP muda.
# Requer "Configurações > Geral > Mobile TV On / Ativar via Wi-Fi" ligado na TV.
TV_MAC=

# Identidade da TV, preenchida automaticamente. Ao contrário do IP, não muda —
# é por ela que o controle reencontra a TV depois de uma troca de endereço.
TV_UUID=

# Preenchido automaticamente por `lgremote pair`. Não invente um valor.
TV_CLIENT_KEY=

# --- Catálogo -----------------------------------------------------------
# Token v4 (Bearer) gratuito: themoviedb.org > Settings > API > "API Read Access Token".
# Sem ele, o controle funciona normalmente — só a busca de títulos fica desligada.
TMDB_TOKEN=

# --- Servidor -----------------------------------------------------------
# PIN exigido pelo PWA. Sem isso, qualquer aparelho na rede controla a TV.
UI_PIN=1234

PORT=8765
BIND_HOST=0.0.0.0
